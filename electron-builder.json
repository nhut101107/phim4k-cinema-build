{
  "appId": "com.phim4k.cinema.desktop",
  "productName": "4K Cinema",
  "extraMetadata": { "main": "desktop/main.cjs", "version": "3.4.36", "dependencies": {} },
  "directories": { "output": "builds/windows-3.4.36" },
  "files": ["desktop/**", "public/**", "!public/standalone.html", "package.json"],
  "asar": true,
  "electronFuses": {
    "runAsNode": false,
    "enableNodeOptionsEnvironmentVariable": false,
    "enableNodeCliInspectArguments": false,
    "enableEmbeddedAsarIntegrityValidation": true,
    "onlyLoadAppFromAsar": true
  },
  "win": { "icon": "public/media/phim4k-avatar.png", "target": [{ "target": "portable", "arch": ["x64"] }], "artifactName": "4K-Cinema-Windows-${version}-x64.exe" }
}
