{
  "appId": "com.phim4k.cinema.desktop",
  "productName": "4K Cinema",
  "extraMetadata": { "main": "desktop/main.cjs", "version": "3.50.0", "dependencies": {} },
  "directories": { "output": "builds/windows-3.50" },
  "compression": "normal",
  "files": ["desktop/**", "public/**", "!public/standalone.html", "package.json"],
  "asar": true,
  "electronFuses": {
    "runAsNode": false,
    "enableNodeOptionsEnvironmentVariable": false,
    "enableNodeCliInspectArguments": false,
    "enableEmbeddedAsarIntegrityValidation": true,
    "onlyLoadAppFromAsar": true
  },
  "win": { "icon": "desktop/icon.ico", "target": [{ "target": "portable", "arch": ["x64"] }], "artifactName": "4K-Cinema-Windows-3.50-x64.exe" }
}
