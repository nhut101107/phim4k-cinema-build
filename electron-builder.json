{
  "appId": "com.phim4k.cinema.desktop",
  "productName": "4K Cinema",
  "extraMetadata": { "main": "desktop/main.cjs", "version": "3.54.0", "dependencies": {} },
  "directories": { "output": "builds/windows-3.54" },
  "compression": "normal",
  "files": [
    "desktop/**",
    { "from": "dist-ios", "to": "public", "filter": ["**/*"] },
    { "from": "public/media", "to": "public/media", "filter": ["qa-seek.mp4"] },
    "package.json"
  ],
  "asar": true,
  "electronFuses": {
    "runAsNode": false,
    "enableNodeOptionsEnvironmentVariable": false,
    "enableNodeCliInspectArguments": false,
    "enableEmbeddedAsarIntegrityValidation": true,
    "onlyLoadAppFromAsar": true
  },
  "win": { "icon": "desktop/icon.ico", "target": [{ "target": "nsis", "arch": ["x64"] }], "artifactName": "4K-Cinema-Windows-3.54-x64.exe" },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "4K Cinema",
    "deleteAppDataOnUninstall": false
  }
}
