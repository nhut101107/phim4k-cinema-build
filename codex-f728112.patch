+.feedback-header p { margin: 0 0 18px; color: var(--text-muted); line-height: 1.55; }
+.feedback-form { display: grid; gap: 12px; }
+.feedback-form label { display: grid; gap: 6px; color: #d9e2f0; font-size: 13px; font-weight: 750; }
+.feedback-form input,
+.feedback-form select,
+.feedback-form textarea {
+  width: 100%;
+  box-sizing: border-box;
+  padding: 12px 13px;
+  border: 1px solid rgba(255,255,255,.12);
+  border-radius: 11px;
+  color: #fff;
+  background: rgba(5, 10, 20, .88);
+  font: 500 14px/1.45 var(--font);
+}
+.feedback-form textarea { resize: vertical; min-height: 120px; }
+.feedback-thread-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 24px; }
+.feedback-thread-heading h3 { margin: 0; }
+.feedback-thread-list { display: grid; gap: 12px; margin-top: 12px; }
+.feedback-empty { color: var(--text-muted); text-align: center; }
+.feedback-ticket {
+  padding: 14px;
+  border: 1px solid rgba(255,255,255,.1);
+  border-radius: 13px;
+  background: rgba(10, 17, 30, .78);
+}
+.feedback-ticket.status-answered { border-color: rgba(52, 211, 153, .35); }
+.feedback-ticket-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
+.feedback-ticket-heading span { flex: 0 0 auto; color: #f5c451; font-size: 11px; font-weight: 800; }
+.feedback-ticket p { margin: 9px 0; color: #d9e2f0; white-space: pre-wrap; }
+.feedback-ticket small { color: var(--text-muted); }
+.feedback-admin-reply { margin-top: 12px; padding: 12px; border-left: 3px solid #34d399; border-radius: 8px; background: rgba(52, 211, 153, .08); }
+.feedback-admin-reply b { color: #6ee7b7; }
+.feedback-admin-existing-reply { color: #6ee7b7 !important; }
+
+@media (max-width: 640px) {
+  .feedback-dialog { padding: 22px 15px 18px; }
+  .feedback-fab { bottom: calc(76px + env(safe-area-inset-bottom)); padding: 0 13px; }
+  .feedback-ticket-heading { display: grid; }
+}
